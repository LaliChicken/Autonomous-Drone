{
  "permissions": {
    "allow": [
      "Bash(xargs -0 ls -la)",
      "Bash(awk '{print $5\"\\\\t\"$9}')",
      "Bash(sort -k2)",
      "Bash(uv venv *)",
      "Bash(.venv/bin/python --version)",
      "Bash(uv pip *)",
      "Bash(git checkout *)",
      "Bash(.venv/bin/python -c ' *)",
      "Bash(.venv/bin/ruff check *)",
      "Bash(echo \"exit=$?\")",
      "Bash(echo \"=== ruff exit: $? ===\")",
      "Bash(.venv/bin/python -m pytest -q)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}
